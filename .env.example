# PlateRoute Customer App — environment template
# Copy to `.env` (cp .env.example .env) and fill real values.
# NEVER commit .env — it is gitignored. 10.0.2.2 = Android emulator loopback to host.

# Backend REST API (Django + DRF, /api/v1/)
API_BASE_URL=http://10.0.2.2:8000/api/v1/

# WebSocket channels (live order tracking, chat)
WS_BASE_URL=ws://10.0.2.2:8000/ws

# Error tracking (release-tagged; leave empty for dev)
SENTRY_DSN=

# Stripe payment sheet (test key in dev)
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# OSM raster tiles served by self-hosted tileserver-gl (see implementation_plan/04_MAPS_OSM_OSRM.md)
MAP_TILE_URL_TEMPLATE=http://10.0.2.2:8081/tiles/{z}/{x}/{y}.png

# Geocoding goes client -> backend -> Photon (never direct)
GEOCODE_PROXY_BASE_URL=http://10.0.2.2:8000/api/v1/geocode/
